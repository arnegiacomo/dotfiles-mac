{
  "permissions": {
    "defaultMode": "default"
  },
  "model": "opus",
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/arnegiacomo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/arnegiacomo/.claude/hooks/herdr-desktop-notify.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "sh '/Users/arnegiacomo/.claude/hooks/herdr-desktop-notify.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
